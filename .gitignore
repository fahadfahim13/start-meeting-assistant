# dependencies
node_modules/
.pnp.*

# build output
dist/
dist-electron/
out/
release/
*.tsbuildinfo

# user data — never commit recordings or models
recordings/
models/
data/
*.mkv
*.mp4
*.wav
*.gguf
*.bin
*.onnx
*.traineddata

# bundled binaries (fetched at build time, pinned by hash)
resources/bin/

# logs
logs/
*.log
npm-debug.log*

# test artifacts
coverage/
playwright-report/
test-results/
!tests/fixtures/**

# spikes produce throwaway output
spikes/**/out/
spikes/**/*.pcm

# spike binaries and models are FETCHED, never committed.
# The fetch commands live in each spike's README so the setup stays reproducible
# without putting hundreds of MB of third-party binaries in git history.
spikes/**/bin/
spikes/**/models/
*.zip

# env
.env
.env.local
!.env.example

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
