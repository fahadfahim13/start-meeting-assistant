# MeetFroge - local development overrides
# Copy to .env. Never commit .env.
# There are no secrets here by design: the app makes no authenticated network calls.

# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Override the data directory (default: %LOCALAPPDATA%\MeetFroge)
# MEETFROGE_DATA_DIR=

# Force an encoder instead of probing. For testing fallback ladders.
# One of: h264_amf | h264_nvenc | h264_qsv | libx264
# MEETFROGE_FORCE_ENCODER=

# Disable Vulkan offload to test the CPU inference path
# MEETFROGE_DISABLE_VULKAN=1
